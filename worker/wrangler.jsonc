{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sdlcloud",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sdl",
      "database_id": "181e1d91-f509-437e-80bf-93e8b2dc11a9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://sdlcloud.sdlloan1.workers.dev",
    "MAIL_FROM": "SDL <no-reply@shubhdhanlakshmi.com>"
  },
  "triggers": {
    "crons": ["30 2 * * *"]
  }
}
